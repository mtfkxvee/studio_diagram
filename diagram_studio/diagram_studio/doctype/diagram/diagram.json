{
  "doctype": "DocType",
  "name": "Diagram",
  "module": "Diagram Studio",
  "custom": 0,
  "istable": 0,
  "issingle": 0,
  "track_changes": 1,
  "autoname": "field:title",
  "sort_field": "modified",
  "sort_order": "DESC",
  "engine": "InnoDB",
  "fields": [
    {
      "fieldname": "title",
      "fieldtype": "Data",
      "label": "Title",
      "reqd": 1,
      "unique": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "diagram_type",
      "fieldtype": "Select",
      "label": "Diagram Type",
      "options": "Flowchart\nOrg Chart\nERD\nOther",
      "default": "Flowchart",
      "in_list_view": 1,
      "in_standard_filter": 1
    },
    {
      "fieldname": "column_break_1",
      "fieldtype": "Column Break"
    },
    {
      "fieldname": "description",
      "fieldtype": "Small Text",
      "label": "Description"
    },
    {
      "fieldname": "section_break_1",
      "fieldtype": "Section Break",
      "label": "Canvas"
    },
    {
      "fieldname": "canvas_json",
      "fieldtype": "Long Text",
      "label": "Canvas JSON",
      "description": "Struktur nodes + edges (React Flow format). Diisi/dibaca lewat halaman Diagram Studio, bukan diedit manual.",
      "hidden": 1
    },
    {
      "fieldname": "section_break_2",
      "fieldtype": "Section Break",
      "label": "Referenced Records"
    },
    {
      "fieldname": "references",
      "fieldtype": "Table",
      "label": "References",
      "options": "Diagram Reference",
      "read_only": 1
    }
  ],
  "permissions": [
    {
      "role": "System Manager",
      "read": 1,
      "write": 1,
      "create": 1,
      "delete": 1,
      "share": 1,
      "print": 1,
      "export": 1
    },
    {
      "role": "All",
      "read": 1,
      "write": 1,
      "create": 1
    }
  ]
}
